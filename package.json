{
  "name": "freitas-growth-loop-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev -p 3001",
    "admin:dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "admin:start": "cross-env NODE_ENV=production node src/server.js",
    "admin:create-user": "node src/scripts/create-admin.js",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.0",
    "@adminjs/sequelize": "^4.1.0",
    "@prisma/client": "6.19.3",
    "adminjs": "~7.8.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lucide-react": "1.14.0",
    "next": "15.5.16",
    "next-auth": "4.24.14",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.8.1",
    "resend": "6.12.3",
    "sequelize": "^6.37.5",
    "tslib": "^2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "^7.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.16",
    "nodemon": "^3.1.9",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
  
}
