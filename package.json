{
  "name": "freitas-growth-loop-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node scripts/check-dev-ports.mjs",
    "dev": "concurrently --kill-others-on-fail --names WEB,ADMIN,MAIL --prefix-colors cyan,magenta,yellow \"npm run web:dev\" \"npm run admin:server:dev\" \"npm run email:dev\"",
    "dev:app": "concurrently --kill-others-on-fail --names WEB,ADMIN --prefix-colors cyan,magenta \"npm run web:dev\" \"npm run admin:server:dev\"",
    "web:dev": "next dev -p 3001",
    "email:dev": "maildev --smtp 1025 --web 1080",
    "email:test": "node scripts/send-test-email.mjs",
    "admin:dev": "npm run dev",
    "admin:server:dev": "cross-env NODE_ENV=development nodemon --exitcrash src/server.js",
    "admin:start": "cross-env NODE_ENV=production node src/server.js",
    "admin:grant-access": "node src/scripts/create-admin.js",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate-lead-campaigns": "node scripts/migrate-lead-campaigns.mjs",
    "db:migrate-lead-campaigns:dry-run": "node scripts/migrate-lead-campaigns.mjs --dry-run",
    "db:seed-growth-loop": "node scripts/seed-growth-loop.mjs"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.0",
    "@adminjs/prisma": "^5.0.4",
    "@prisma/client": "6.19.3",
    "adminjs": "~7.8.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lucide-react": "1.14.0",
    "next": "15.5.16",
    "next-auth": "4.24.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "emailjs": "5.0.2",
    "tslib": "^2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.16",
    "maildev": "2.2.1",
    "nodemon": "^3.1.9",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
